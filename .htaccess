DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # -------------------------------------------------------------------------
    # CodeIgniter 3 — subdirectory-safe rewrite (WAMP / Apache)
    # Works when the app lives at e.g. http://localhost/webshopapi/ or …/elintomapi/
    # CMS pages do NOT need routes.php entries: Webshop::_remap() resolves slugs.
    # -------------------------------------------------------------------------

    # If you still get 404 on clean URLs, uncomment and set your folder name:
    # RewriteBase /webshopapi/

    # Never route these through index.php
    RewriteRule ^(application|system)/ - [F,L,NC]
    RewriteRule ^assets/ - [L,NC]

    # Fix relative asset URLs resolved from index.php/webshop/* pages
    RewriteRule ^index\.php/assets/(.*)$ assets/$1 [L,NC]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?/$1 [L,QSA]
</IfModule>
